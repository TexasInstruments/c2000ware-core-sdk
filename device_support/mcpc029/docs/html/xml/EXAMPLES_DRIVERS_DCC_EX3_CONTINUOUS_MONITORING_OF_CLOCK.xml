</entry><entry thead="no"><para>1%    </para>
</entry></row>
<row>
<entry thead="no"><para><bold>Frequency Error Tolerance</bold>   </para>
</entry><entry thead="no"><para>1.5%   </para>
</entry></row>
</table>
</para>
