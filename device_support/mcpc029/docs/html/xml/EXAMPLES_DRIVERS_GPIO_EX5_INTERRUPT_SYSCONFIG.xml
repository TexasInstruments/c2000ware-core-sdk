<listitem><para>None</para>
</listitem></itemizedlist>
</para>
</sect1>
<sect1 id="EXAMPLES_DRIVERS_GPIO_EX5_INTERRUPT_SYSCONFIG_1autotoc_md260">
<title>Watch variables</title>
