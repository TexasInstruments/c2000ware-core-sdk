<projectSpec>
  <project
        name="ex_target_host_comm_protocol_f28p55x"
        device="TMS320F28P550SJ9"
        products="sysconfig;C2000WARE"
        cgtVersion="25.11.1.LTS"
        outputFormat="ELF"
        launchWizard="False"
        linkerCommandFile=""
        enableSysConfigTool="true"
        sysConfigBuildOptions="--product ${C2000WARE_ROOT}/.metadata/sdk.json --device F28P55x --package 128PDT --part F28P55x_128PDT"
        >

    <configuration name="CPU1_FLASH" compilerBuildOptions="--opt_level=off -I${PROJECT_ROOT}/device -I${C2000WARE_DLIB_ROOT} -I${DAP_COMMON_ROOT}  -v28 -ml -mt --float_support=fpu32 --tmu_support=tmu0	--define=DEBUG --define=_FLASH --diag_warning=225 --diag_suppress=10063"  linkerBuildOptions="--entry_point code_start --stack_size=0x400 --heap_size=0x100"/>
    <configuration name="CPU1_LAUNCHXL_FLASH" compilerBuildOptions="--opt_level=off -I${PROJECT_ROOT}/device -I${C2000WARE_DLIB_ROOT} -I${DAP_COMMON_ROOT}  -v28 -ml -mt --float_support=fpu32 --tmu_support=tmu0 --define=_LAUNCHXL_F28P55X	--define=DEBUG --define=_FLASH --diag_warning=225 --diag_suppress=10063"  linkerBuildOptions="--entry_point code_start --stack_size=0x400 --heap_size=0x100"/>
    
    <pathVariable name="C2000WARE_DLIB_ROOT" path="../../../../../../../driverlib/f28p55x/driverlib/" scope="project"/>
    <pathVariable name="C2000WARE_DEVICE_SUPPORT" path="../../../../../../../device_support" scope="project"/>
    <pathVariable name="C2000WARE_LIBRARIES" path="../../../../../../../libraries" scope="project"/>
    <pathVariable name="C2000WARE_ROOT" path="../../../../../../../" scope="project" />
    <pathVariable name="DAP_COMMON_ROOT" path="../../../../../../../libraries/ai/common/dap" scope="project"/>
    
    <file action="copy" path="C2000WARE_DEVICE_SUPPORT/f28p55x/common/include/driverlib.h" targetDirectory="device"/>
    <file action="copy" path="C2000WARE_DEVICE_SUPPORT/f28p55x/common/include/device.h" targetDirectory="device"/>
    <file action="copy" path="C2000WARE_DEVICE_SUPPORT/f28p55x/common/source/device.c" targetDirectory="device"/>
    <file action="copy" path="C2000WARE_DEVICE_SUPPORT/f28p55x/common/source/f28p55x_codestartbranch.asm" targetDirectory="device"/>
    <file action="copy" path="C2000WARE_DEVICE_SUPPORT/f28p55x/common/targetConfigs/TMS320F28P550SJ9_LaunchPad.ccxml" targetDirectory="targetConfigs"/>
    <file action="copy" path="C2000WARE_DEVICE_SUPPORT/f28p55x/common/targetConfigs/TMS320F28P550SJ9.ccxml" targetDirectory="targetConfigs" applicableConfigurations="CPU1_FLASH"/>
    <file action="link" path="C2000WARE_DLIB_ROOT/ccs/Debug/driverlib.lib" targetDirectory=""/>
    <file action="copy" path="../dap_test_main.c" targetDirectory=""/>
    <file action="link" path="DAP_COMMON_ROOT/Dap.h" targetDirectory="dap_common"/>
    <file action="link" path="DAP_COMMON_ROOT/Dap.c" targetDirectory="dap_common"/>
    <file action="link" path="DAP_COMMON_ROOT/dap_core/Dap_Core.h" targetDirectory="dap_common/dap_core"/>
    <file action="link" path="DAP_COMMON_ROOT/dap_core/Dap_Core.c" targetDirectory="dap_common/dap_core"/>
    <file action="link" path="DAP_COMMON_ROOT/dap_interface/Dap_Interface.h" targetDirectory="dap_common/dap_interface"/>
    <file action="link" path="DAP_COMMON_ROOT/dap_link/Dap_Link.h" targetDirectory="dap_common/dap_link"/>
    <file action="link" path="DAP_COMMON_ROOT/dap_link/Dap_Link.c" targetDirectory="dap_common/dap_link"/>
    <file action="link" path="DAP_COMMON_ROOT/Std_Types.h" targetDirectory="dap_common"/>
    <file action="link" path="DAP_COMMON_ROOT/dap_link/Uart_Hal.h" targetDirectory="dap_common/dap_link"/>
    <file action="link" path="DAP_COMMON_ROOT/dap_link/Uart_Hal.c" targetDirectory="dap_common/dap_link"/>
    <file action="copy" path="../28p55x_dap_flash_lnk.cmd" targetDirectory=""/>
    <file action="copy" path="../c2000.syscfg" targetDirectory=""/>
	
    </project>
</projectSpec>
