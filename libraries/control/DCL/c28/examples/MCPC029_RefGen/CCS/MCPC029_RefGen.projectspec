<projectSpec>
  <project
        name="MCPC029_RefGen"
        device="Generic C28xx Device"
        cgtVersion="25.11.1.LTS"
        products="sysconfig;C2000WARE"
        outputFormat="ELF"
        launchWizard="False"
        linkerCommandFile=""
	      enableSysConfigTool="true"
        sysConfigBuildOptions="--product ${C2000WARE_ROOT}/.metadata/sdk.json --device MCPC029 --package 48RGZ --part MCPC029_48RGZ"
        >
    <configuration name="CPU1_FLASH" compilerBuildOptions="--opt_level=off -I${C2000WARE_ROOT} -v28 -ml -mt  --float_support=fpu32 --fp_mode=relaxed --gen_func_subsections=on --define=DEBUG --define=_FLASH --define=generic_flash_lnk --diag_warning=225 --diag_suppress=10063" linkerBuildOptions="--entry_point code_start --stack_size=0x200 --heap_size=0x100  --define=_FLASH -i${C2000WARE_ROOT} -i${PROJECT_BUILD_DIR}/syscfg -lc2000ware_libraries.cmd.genlibs -lboard.cmd.genlibs -ldevice_cmd.cmd.genlibs --define=generic_flash_lnk"/>
    <pathVariable name="C2000WARE_ROOT" path="../../../../../../../" scope="project" />
    <pathVariable name="C2000WARE_DLIB_ROOT" path="../../../../../../../driverlib/mcpc029/driverlib/" scope="project"/>
    <buildVariable name="GENERATE_DIAGRAM" value="0" scope="project" />
    <file action="copy" path="../../../../../../../device_support/mcpc029/common/targetConfigs/MCPC029.ccxml" targetDirectory="targetConfigs"/>
    <file action="copy" path="../MCPC029_RefGen.c" targetDirectory=""/>
    <file action="copy" path="../MCPC029_refgen.syscfg" targetDirectory=""/>
	</project>
</projectSpec>
